# Include package files
include LICENSE
include README.md
include pyproject.toml

# Include documentation
recursive-include docs *.md
recursive-include docs *.rst

# Exclude examples entirely from the distribution
prune examples

# Exclude output folders and generated files
prune **/__pycache__
prune **/*.egg-info
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.parquet
global-exclude *.geojson
global-exclude .DS_Store
